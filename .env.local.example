# Local Development Environment
# Copy this to .env.local and fill in your local database credentials

# Local database connection
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/welfare_dev

# Session secret - generate with: openssl rand -base64 32
SESSION_SECRET=your-local-session-secret-change-this

# Server port
PORT=5000

# Development mode
NODE_ENV=development

# Optional: Chapa payment key (only if testing payments)
# CHAPA_SECRET_KEY=CHASECK_TEST-your-test-key
